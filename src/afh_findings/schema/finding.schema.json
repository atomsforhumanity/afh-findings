{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://findings.afh.org/schema/finding.schema.json",
  "title": "AFH finding (core)",
  "description": "The minimum every finding meets. Profiles add their own keys under their namespace.",
  "type": "object",
  "required": ["title", "claim", "authors", "project", "kind", "status", "scope", "data", "code"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "description": "The claim as one sentence, not a topic.",
      "type": "string", "minLength": 10, "maxLength": 250, "pattern": "^[^\\n]+$"
    },
    "claim": {
      "description": "The finding with its key numbers, a few sentences at most.",
      "type": "string", "minLength": 20
    },
    "authors": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name"], "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 2},
          "orcid": {"type": "string", "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"},
          "affiliation": {"type": "string"}
        }
      }
    },
    "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "kind": {"enum": ["result", "method", "resource", "informative-failure"]},
    "status": {"enum": ["preliminary", "verified"]},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "scope": {
      "type": "object", "required": ["not_tested"],
      "properties": {
        "not_tested": {
          "description": "What this finding does not show. At least one honest entry.",
          "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}
        }
      }
    },
    "data": {"$ref": "#/$defs/materials"},
    "code": {"$ref": "#/$defs/materials"},
    "upstream": {
      "description": "Datasets and software this builds on.",
      "type": "array",
      "items": {
        "type": "object", "required": ["name"], "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "doi": {"type": "string"},
          "url": {"type": "string"},
          "license": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    },
    "builds_on": {
      "description": "Other findings, pinned to a version.",
      "type": "array", "items": {"type": "string", "pattern": "^F\\d{4}/v\\d+$"}
    },
    "supersedes": {"type": "string", "pattern": "^F\\d{4}$"},
    "entry": {"type": "string", "minLength": 1},
    "check": {
      "description": "Command that recomputes the stated numbers from the bundle; run from a fresh copy at publish.",
      "type": "string", "minLength": 1
    },
    "license": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "text": {"type": "string"},
        "data": {"type": "string"},
        "code": {"type": "string"}
      }
    },
    "change": {
      "type": "object", "required": ["type", "summary"], "additionalProperties": false,
      "properties": {
        "type": {"enum": ["corrected", "expanded", "strengthened", "weakened", "revised"]},
        "summary": {"type": "string", "minLength": 5}
      }
    },
    "profiles": {"type": "array", "items": {"type": "string"}},
    "exclude": {"type": "array", "items": {"type": "string"}},
    "privacy_allow": {"type": "array", "items": {"type": "string"}},
    "private": {"description": "Never published."}
  },
  "$defs": {
    "materials": {
      "oneOf": [
        {
          "type": "array", "minItems": 1,
          "items": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {
                "type": "object", "required": ["path"], "additionalProperties": false,
                "properties": {"path": {"type": "string"}, "description": {"type": "string"}}
              }
            ]
          }
        },
        {
          "type": "object", "required": ["none"], "additionalProperties": false,
          "properties": {"none": {"type": "string", "minLength": 5}}
        }
      ]
    }
  }
}
